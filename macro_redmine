' 未登録の項目だけ追記する（記入済みの値は触らない）
Private Sub AddSetting(ws As Worksheet, ByVal key As String, ByVal defVal As Variant, ByVal note As String)
    Dim r As Long
    r = FindSettingRow(ws, key)
    If r > 0 Then
        If Len(TrimSpaces(CStr(ws.Cells(r, 3).Value))) = 0 Then ws.Cells(r, 3).Value = note
        Exit Sub
    End If
    r = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
    If r < 2 Then r = 2
    ws.Cells(r, 1).Value = key
    ws.Cells(r, 2).Value = defVal
    ws.Cells(r, 3).Value = note
    ws.Cells(r, 2).WrapText = True
    ws.Cells(r, 2).HorizontalAlignment = xlLeft
End Sub

Private Function FindSettingRow(ws As Worksheet, ByVal key As String) As Long
    Dim lastRow As Long, r As Long
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    For r = 2 To lastRow
        If NormalizeKey(CStr(ws.Cells(r, 1).Value)) = NormalizeKey(key) Then
            FindSettingRow = r
            Exit Function
        End If
    Next r
End Function

' 設定シートを辞書に読み込む。無ければ作成を案内して Nothing を返す。
Private Function LoadConfig(wb As Workbook) As Object
    Dim ws As Worksheet
    Set ws = SheetOrNothing(wb, CFG_SHEET)
    If ws Is Nothing Then
        If MsgBox("「" & CFG_SHEET & "」シートがありません。" & vbCrLf & _
                  "今すぐ作成しますか？", vbOKCancel + vbQuestion) = vbOK Then
            Redmine_設定シートを作成
        End If
        Exit Function
    End If

    Dim d As Object: Set d = CreateObject("Scripting.Dictionary")
    Dim lastRow As Long, r As Long, k As String
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    For r = 2 To lastRow
        k = NormalizeKey(CStr(ws.Cells(r, 1).Value))
        If Len(k) > 0 Then d(k) = ws.Cells(r, 2).Value
    Next r
    Set LoadConfig = d
End Function

Private Function ValidateConfig(cfg As Object, Optional ByVal skipProject As Boolean = False) As Boolean
    Dim miss As String
    If Len(CfgS(cfg, "RedmineのURL")) = 0 Then miss = miss & vbCrLf & "・RedmineのURL"
    If Len(CfgS(cfg, "APIキー")) = 0 Then miss = miss & vbCrLf & "・APIキー"
    If Not skipProject Then
        If Len(CfgS(cfg, "プロジェクト識別子")) = 0 Then miss = miss & vbCrLf & "・プロジェクト識別子"
    End If
    If Len(miss) > 0 Then
        MsgBox "「" & CFG_SHEET & "」シートの次の項目が未入力です。" & miss, vbExclamation
        Exit Function
    End If
    If InStr(1, CfgS(cfg, "RedmineのURL"), "://", vbTextCompare) = 0 Then
        MsgBox "RedmineのURL は http:// または https:// から入力してください。", vbExclamation
        Exit Function
    End If
    ValidateConfig = True
End Function

Private Function BaseUrl(cfg As Object) As String
    Dim s As String
    s = CfgS(cfg, "RedmineのURL")
    Do While Right$(s, 1) = "/"
        s = Left$(s, Len(s) - 1)
    Loop
    BaseUrl = s
End Function

Private Function CfgS(cfg As Object, ByVal key As String) As String
    Dim k As String: k = NormalizeKey(key)
    If cfg Is Nothing Then Exit Function
    If cfg.Exists(k) Then CfgS = TrimSpaces(CStr(cfg(k)))
End Function

Private Function CfgL(cfg As Object, ByVal key As String, ByVal defVal As Long) As Long
    Dim s As String: s = CfgS(cfg, key)
    If Len(s) = 0 Or Not IsNumeric(s) Then
        CfgL = defVal
    Else
        CfgL = CLng(Val(s))
    End If
End Function

Private Function CfgB(cfg As Object, ByVal key As String, ByVal defVal As Boolean) As Boolean
    Dim s As String: s = LCase$(CfgS(cfg, key))
    Select Case s
        Case "true", "1", "-1", "yes", "y", "○", "◯", "〇", "はい", "する"
            CfgB = True
        Case "false", "0", "no", "n", "×", "✕", "いいえ", "しない"
            CfgB = False
        Case ""
            CfgB = defVal
        Case Else
            CfgB = defVal
    End Select
End Function

' 行の上書き値があればそちら、無ければ設定シートの値
Private Function PickVal(ov As Object, ByVal rowKey As String, cfg As Object, ByVal cfgKey As String) As String
    If Not ov Is Nothing Then
        If ov.Exists(rowKey) Then
            PickVal = CStr(ov(rowKey))
            Exit Function
        End If
    End If
    PickVal = CfgS(cfg, cfgKey)
End Function

' 設定キーの表記ゆれ吸収（空白・全角半角・大小文字）
Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = Replace$(CStr(s), " ", "")
    t = Replace$(t, "　", "")
    t = Replace$(t, "(", "（")
    t = Replace$(t, ")", "）")
    On Error Resume Next
    t = StrConv(t, vbNarrow)
    On Error GoTo 0
    NormalizeKey = LCase$(t)
End Function


'======================================================================
'  JSON（軽量）
'======================================================================
Private Function JsonEsc(ByVal s As String) As String
    Dim i As Long, ch As String, code As Long, out As String
    s = Replace$(s, vbCrLf, vbLf)
    s = Replace$(s, vbCr, vbLf)
    s = Replace$(s, Chr$(11), vbLf)      ' 図形内の手動改行
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        Select Case ch
            Case """": out = out & "\"""
            Case "\": out = out & "\\"
            Case vbLf: out = out & "\n"
            Case vbTab: out = out & "\t"
            Case Else
                code = AscW(ch)
                If code < 0 Then code = code + 65536
                If code < 32 Then
                    out = out & "\u" & Right$("000" & Hex$(code), 4)
                Else
                    out = out & ch
                End If
        End Select
    Next i
    JsonEsc = out
End Function

Private Function JsonUnesc(ByVal s As String) As String
    Dim i As Long, ch As String, nx As String, out As String
    i = 1
    Do While i <= Len(s)
        ch = Mid$(s, i, 1)
        If ch = "\" And i < Len(s) Then
            nx = Mid$(s, i + 1, 1)
            Select Case nx
                Case "n": out = out & vbLf: i = i + 2
                Case "r": out = out & vbCr: i = i + 2
                Case "t": out = out & vbTab: i = i + 2
                Case "u"
                    If i + 5 <= Len(s) Then
                        out = out & ChrW$(CLng("&H" & Mid$(s, i + 2, 4)))
                        i = i + 6
                    Else
                        out = out & nx: i = i + 2
                    End If
                Case Else: out = out & nx: i = i + 2
            End Select
        Else
            out = out & ch
            i = i + 1
        End If
    Loop
    JsonUnesc = out
End Function

' "key": 123 の数値を取り出す（最初の1つ）
Private Function JsonNumber(ByVal json As String, ByVal key As String) As Long
    Dim re As Object: Set re = CreateObject("VBScript.RegExp")
    re.Global = False
    re.Pattern = """" & key & """\s*:\s*(\d+)"
    Dim mc As Object: Set mc = re.Execute(json)
    If mc.Count > 0 Then JsonNumber = CLng(mc(0).SubMatches(0))
End Function

' "key": "値" の文字列を取り出す（最初の1つ）
Private Function JsonString(ByVal json As String, ByVal key As String) As String
    Dim re As Object: Set re = CreateObject("VBScript.RegExp")
    re.Global = False
    re.Pattern = """" & key & """\s*:\s*""((?:[^""\\]|\\.)*)"""
    Dim mc As Object: Set mc = re.Execute(json)
    If mc.Count > 0 Then JsonString = JsonUnesc(mc(0).SubMatches(0))
End Function

' "status":{"id":1,"name":"新規"} の name を取り出す
Private Function JsonSubName(ByVal json As String, ByVal objKey As String) As String
    Dim re As Object: Set re = CreateObject("VBScript.RegExp")
    re.Global = False
    re.Pattern = """" & objKey & """\s*:\s*\{[^}]*""name""\s*:\s*""((?:[^""\\]|\\.)*)"""
    Dim mc As Object: Set mc = re.Execute(json)
    If mc.Count > 0 Then JsonSubName = JsonUnesc(mc(0).SubMatches(0))
End Function

' {"errors":["…","…"]} を読める形にする
Private Function JsonErrors(ByVal json As String) As String
    Dim p As Long, q As Long, seg As String
    p = InStr(1, json, """errors""", vbTextCompare)
    If p = 0 Then
        JsonErrors = Left$(TrimSpaces(json), 200)
        Exit Function
    End If
    p = InStr(p, json, "[")
    q = InStr(p, json, "]")
    If p = 0 Or q = 0 Then Exit Function
    seg = Mid$(json, p + 1, q - p - 1)

    Dim re As Object: Set re = CreateObject("VBScript.RegExp")
    re.Global = True
    re.Pattern = """((?:[^""\\]|\\.)*)"""
    Dim mc As Object, m As Object, out As String
    Set mc = re.Execute(seg)
    For Each m In mc
        If Len(out) > 0 Then out = out & " / "
        out = out & JsonUnesc(m.SubMatches(0))
    Next m
    JsonErrors = out
End Function

' 値があるときだけ ,"key":123 を返す
Private Function NumField(ByVal key As String, ByVal val As String) As String
    Dim s As String: s = TrimSpaces(val)
    If Len(s) = 0 Then Exit Function
    If Not IsNumeric(s) Then Exit Function
    NumField = ",""" & key & """:" & CLng(Val(s))
End Function

' 値があるときだけ ,"key":"文字列" を返す
Private Function StrField(ByVal key As String, ByVal val As String) As String
    If Len(TrimSpaces(val)) = 0 Then Exit Function
    StrField = ",""" & key & """:""" & JsonEsc(TrimSpaces(val)) & """"
End Function

' 期日を Redmine が受け取る yyyy-mm-dd に整える
Private Function DateFieldValue(ByVal v As String) As String
    Dim s As String: s = TrimSpaces(v)
    If Len(s) = 0 Then Exit Function
    If IsDate(s) Then
        DateFieldValue = Format$(CDate(s), "yyyy-mm-dd")
    ElseIf IsNumeric(s) Then
        DateFieldValue = Format$(CDate(CDbl(s)), "yyyy-mm-dd")   ' セルのシリアル値
    Else
        DateFieldValue = s
    End If
End Function


'======================================================================
'  文字コード（UTF-8）
'======================================================================
Private Function Utf8Bytes(ByVal s As String) As Variant
    Dim st As Object: Set st = CreateObject("ADODB.Stream")
    st.Type = 2                      ' adTypeText
    st.Charset = "utf-8"
    st.Open
    st.WriteText s
    st.Position = 0
    st.Type = 1                      ' adTypeBinary
    st.Position = 3                  ' BOM(EF BB BF)を読み飛ばす
    Utf8Bytes = st.Read
    st.Close
End Function

Private Function Utf8Text(ByRef bytes As Variant) As String
    On Error GoTo Fallback
    If IsEmpty(bytes) Then Exit Function
    Dim ub As Long: ub = -1
    On Error Resume Next
    ub = UBound(bytes)                  ' 空レスポンスは配列にならない
    On Error GoTo Fallback
    If ub < 0 Then Exit Function
    Dim st As Object: Set st = CreateObject("ADODB.Stream")
    st.Type = 1
    st.Open
    st.Write bytes
    st.Position = 0
    st.Type = 2
    st.Charset = "utf-8"
    Utf8Text = st.ReadText
    st.Close
    Exit Function
Fallback:
    On Error Resume Next
    Utf8Text = CStr(bytes)
End Function


'======================================================================
'  シート・列・その他ヘルパー
'======================================================================
' 一覧シートの判定：アクティブシートが一覧なら優先、違えば名前で探す
Private Function ResolveListSheet() As Worksheet
    Dim wb As Workbook: Set wb = ActiveWorkbook
    If wb Is Nothing Then Exit Function

    If TypeName(ActiveSheet) = "Worksheet" Then
        Dim aw As Worksheet: Set aw = ActiveSheet
        If Left$(aw.Name, Len(LIST_PREFIX)) = LIST_PREFIX Then
            Set ResolveListSheet = aw
            Exit Function
        End If
        ' 名前が違っても、確認事項列に見出しがあれば一覧とみなす
        If Len(TrimSpaces(CStr(aw.Cells(HDR_ROW, COL_ITEM).Value))) > 0 And _
           aw.Name <> CFG_SHEET And aw.Name <> MASTER_SHEET Then
            Set ResolveListSheet = aw
            Exit Function
        End If
    End If

    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If Left$(ws.Name, Len(LIST_PREFIX)) = LIST_PREFIX Then
            Set ResolveListSheet = ws
            Exit Function
        End If
    Next ws
End Function

Private Function SheetOrNothing(wb As Workbook, ByVal nm As String) As Worksheet
    On Error Resume Next
    Set SheetOrNothing = wb.Worksheets(nm)
    On Error GoTo 0
End Function

Private Function GetOrAddSheet(wb As Workbook, ByVal nm As String) As Worksheet
    Dim ws As Worksheet
    Set ws = SheetOrNothing(wb, nm)
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = nm
    End If
    Set GetOrAddSheet = ws
End Function

' 見出し行から列を探す。無ければ 0。
Private Function FindColumn(ws As Worksheet, ByVal header As String) As Long
    Dim c As Long, want As String
    want = NormalizeKey(header)
    For c = 1 To MAX_SCAN_COL
        If NormalizeKey(CStr(ws.Cells(HDR_ROW, c).Value)) = want Then
            FindColumn = c
            Exit Function
        End If
    Next c
End Function

' 見出し行から列を探し、無ければ右端に追加して列番号を返す
Private Function EnsureColumn(ws As Worksheet, ByVal header As String) As Long
    Dim c As Long
    c = FindColumn(ws, header)
    If c > 0 Then
        EnsureColumn = c
        Exit Function
    End If
    c = ws.Cells(HDR_ROW, ws.Columns.Count).End(xlToLeft).Column + 1
    If c < 1 Then c = 1
    ws.Cells(HDR_ROW, c).Value = header
    ws.Cells(HDR_ROW, c).Font.Bold = True
    ws.Columns(c).ColumnWidth = 18
    EnsureColumn = c
End Function

' データ最終行（確認事項列で判定）
Private Function LastDataRow(ws As Worksheet) As Long
    LastDataRow = ws.Cells(ws.Rows.Count, COL_ITEM).End(xlUp).Row
    If LastDataRow < FIRST_DATA_ROW - 1 Then LastDataRow = FIRST_DATA_ROW - 1
End Function

Private Function TrimSpaces(ByVal s As String) As String
    Dim t As String: t = CStr(s)
    Do While Len(t) > 0
        Select Case Left$(t, 1)
            Case " ", "　", vbTab, vbCr, vbLf, Chr$(11)
                t = Mid$(t, 2)
            Case Else
                Exit Do
        End Select
    Loop
    Do While Len(t) > 0
        Select Case Right$(t, 1)
            Case " ", "　", vbTab, vbCr, vbLf, Chr$(11)
                t = Left$(t, Len(t) - 1)
            Case Else
                Exit Do
        End Select
    Loop
    TrimSpaces = t
End Function

' 図形由来の改行（Chr(11)）や CR を LF に揃える
Private Function NormalizeBreaks(ByVal s As String) As String
    Dim t As String
    t = Replace$(s, vbCrLf, vbLf)
    t = Replace$(t, vbCr, vbLf)
    t = Replace$(t, Chr$(11), vbLf)
    NormalizeBreaks = t
End Function

' Application.Wait は1秒刻みのため、短い待ちは自前で回す
Private Sub PauseMs(ByVal ms As Long)
    If ms <= 0 Then Exit Sub
    Dim t0 As Double: t0 = Timer
    Do
        DoEvents
        If Timer < t0 Then Exit Do              ' 日付をまたいだ場合
    Loop While (Timer - t0) * 1000 < ms
End Sub
